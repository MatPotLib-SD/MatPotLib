{
  "expo": {
    "name": "MatPotLib",
    "slug": "matpotlib",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "matpotlib",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.matpotlib.app"
    },
    "android": {
      "package": "com.matpotlib.app"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#2E7D32"
        }
      ],
      "expo-status-bar",
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": "fc020f10-58ba-4828-aca6-0827fe3e3754"
      }
    },
    "owner": "ju354704"
  }
}
