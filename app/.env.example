# Backend REST API (NestJS on Azure Container Apps, or http://localhost:3000 in dev)
EXPO_PUBLIC_BACKEND_URL=http://localhost:3000

# Supabase project (Dashboard -> Settings -> API)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Demo mode: auto sign-in with the demo user and skip onboarding
EXPO_PUBLIC_DEMO_MODE=false
EXPO_PUBLIC_DEMO_EMAIL=demo@example.com
EXPO_PUBLIC_DEMO_PASSWORD=change-me
