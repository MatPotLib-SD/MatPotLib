# Backend target for sim_device / trigger_alert
API_URL=http://localhost:3000
DEVICE_ID=
DEVICE_TOKEN=

# Command-aware sim_capture must use a separately provisioned test device on a local backend
# connected to an isolated test database. Keep it away from event/normal data.
SIM_TEST_DEVICE_ID=
SIM_TEST_DEVICE_TOKEN=
SIM_TEST_ONLY=isolated-local-test-database

# Supabase admin access for seed_demo
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional demo overrides
DEMO_EMAIL=demo@matpotlib.dev
DEMO_PASSWORD=demo-password-123
DEMO_DEVICE_TOKEN=demo-device-token
